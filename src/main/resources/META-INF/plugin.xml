<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cn.elytra.no_infer</id>
    <name>No Infer</name>
    <vendor url="https://github.com/Taskeren">Taskeren</vendor>
    <description>
        <![CDATA[Use `cn.elytra.no_infer.NoInfer` annotation to explicitly mark generic type arguments.]]></description>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.NoInferMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                language="JAVA"
                displayName="Require Explicit Generic Type"
                groupPath="Java"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="cn.elytra.no_infer.JavaExplicitGenericTypeInspection"/>
        <lang.inspectionSuppressor
                language="JAVA"
                implementationClass="cn.elytra.no_infer.JavaRedundantTypeArgumentsSuppressor"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                language="kotlin"
                displayName="Require Explicit Generic Type"
                groupPath="Kotlin"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="cn.elytra.no_infer.KotlinExplicitGenericTypeInspection"/>
        <lang.inspectionSuppressor
                language="kotlin"
                implementationClass="cn.elytra.no_infer.KotlinRemoveExplicitTypeArgumentsSuppressor"/>
    </extensions>
</idea-plugin>
